# Local Unreal Engine WebSocket connection.
ARENA_BRIDGE_HOST=127.0.0.1
ARENA_BRIDGE_PORT=8080
ARENA_BRIDGE_ALLOW_PRIVATE_NETWORK_CONNECTIONS=false
ARENA_BRIDGE_QUEUE_LIMIT=100
ARENA_BRIDGE_QUEUE_TTL_MS=15000
ARENA_BRIDGE_STATUS_TIMEOUT_MS=30000
ARENA_BRIDGE_MODE=stdin

# Twitch values will be used starting with TW-2. Keep real values only in .env.
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
