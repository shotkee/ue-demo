# Local Unreal Engine WebSocket connection.
ARENA_BRIDGE_HOST=127.0.0.1
ARENA_BRIDGE_PORT=8080
ARENA_BRIDGE_ALLOW_PRIVATE_NETWORK_CONNECTIONS=false
ARENA_BRIDGE_QUEUE_LIMIT=100
ARENA_BRIDGE_QUEUE_TTL_MS=15000
ARENA_BRIDGE_STATUS_TIMEOUT_MS=30000
ARENA_BRIDGE_MODE=stdin

# Twitch chat safety limits.
ARENA_TWITCH_USER_COOLDOWN_MS=750
ARENA_TWITCH_GLOBAL_COMMANDS_PER_SECOND=20
ARENA_TWITCH_USER_QUEUE_LIMIT=4
ARENA_TWITCH_MAX_PARTICIPANTS=20
ARENA_TWITCH_MAX_MESSAGE_LENGTH=200

# Public ID of the shared Shotkee Arena Command Bridge Twitch application.
# A fork may override it with the public Client ID of its own Twitch application.
TWITCH_CLIENT_ID=egf7brtj87mffvnv4gka0m3ccad1pm

# Leave empty to use the channel of the Twitch account that authorizes the bridge.
TWITCH_CHANNEL_LOGIN=
